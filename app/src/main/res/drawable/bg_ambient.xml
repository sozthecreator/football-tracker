<?xml version="1.0" encoding="utf-8"?>
<!-- Background behind the whole screen: soft coloured light for the glass cards to show. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="?attr/palBg" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.18" android:centerY="0.22" android:gradientRadius="260dp"
                android:startColor="?attr/palAmbient1" android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.86" android:centerY="0.7" android:gradientRadius="220dp"
                android:startColor="?attr/palAmbient2" android:endColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.55" android:centerY="0.05" android:gradientRadius="200dp"
                android:startColor="?attr/palAmbient3" android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
